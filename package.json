{
  "name": "localclip",
  "version": "0.1.0",
  "private": true,
  "author": "LocalClip contributors",
  "license": "UNLICENSED",
  "description": "게시판을 모으고, 마음에 드는 글을 간직하는 데스크톱 앱",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build && electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "package:win": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.localclip.desktop",
    "productName": "LocalClip",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "portable" }
  }
}
